    "express": "^5.2.1",
    "firebase": "^13.3.0",
    "html2canvas": "^1.4.1",
    "html2canvas-pro": "^2.6.4",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
